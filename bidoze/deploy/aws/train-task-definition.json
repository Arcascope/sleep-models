{
  "family": "bidoze-train",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${TASK_ROLE_ARN}",
  "cpu": "7168",
  "memory": "28672",
  "containerDefinitions": [
    {
      "name": "bidoze-train",
      "image": "${IMAGE}",
      "essential": true,
      "resourceRequirements": [{ "type": "GPU", "value": "1" }],
      "environment": [
        { "name": "BIDOZE_RUN_ID", "value": "${RUN_ID}" },
        { "name": "BIDOZE_RESULTS_S3_PREFIX", "value": "${RESULTS_URI}" },
        { "name": "BIDOZE_TRAINING_CONFIG", "value": "${TRAINING_CONFIG}" },
        { "name": "PYTHONUNBUFFERED", "value": "1" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "train"
        }
      },
      "linuxParameters": { "sharedMemorySize": 2048 },
      "stopTimeout": 120
    }
  ]
}
