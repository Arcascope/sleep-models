{
    "type": "watchtree",
    "features": {
        "at_time": [
            "jerk", "jerk_peak", "lfm", "angle", "angle_step", "daz", "sib",
            "hr", "hr_std", "hr_n", "hr_missing", "hr_base", "hr_rel",
            "tsb_min", "tnb_min"
        ],
        "jerk": {
            "b_spans": {"mean": [1, 5, 15, 30, 60, 120], "max": [5, 30, 120]},
            "f_spans": {"mean": [5, 15, 45], "max": [5, 15, 45]}
        },
        "lfm": {
            "b_spans": {"mean": [5, 15, 60], "max": [15]},
            "f_spans": {"mean": [5, 15, 45]}
        },
        "act": {
            "b_spans": {"mean": [5, 15, 60, 120]},
            "f_spans": {"mean": [5, 15, 45]}
        },
        "angle": {
            "b_spans": {"std": [15, 60]},
            "f_spans": {"std": [15, 45]}
        },
        "angle_step": {
            "b_spans": {"mean": [5, 15, 30, 60, 120], "max": [15, 60]},
            "f_spans": {"mean": [5, 15, 45], "max": [15, 45]}
        },
        "daz": {
            "b_spans": {"mean": [15, 60]},
            "f_spans": {"mean": [15, 45]}
        },
        "sib": {
            "b_spans": {"mean": [5, 15, 60]},
            "f_spans": {"mean": [15]}
        },
        "hr": {
            "b_spans": {"mean": [5, 15, 30, 60], "std": [5, 15, 60]},
            "f_spans": {"mean": [5, 15, 45], "std": [15, 45]}
        },
        "hr_rel": {
            "b_spans": {"mean": [5, 15, 60]},
            "f_spans": {"mean": [15, 45]}
        },
        "hr_valid": {
            "b_spans": {"mean": [15]},
            "f_spans": {"mean": [15]}
        }
    },
    "resample": false,
    "uncropped": true
}
